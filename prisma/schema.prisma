generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["orders_service", "auth_service", "cash_service", "calls_service", "references_service"]
}

// ─────────────────────────────────────────
// Schema: references_service (read-only)
// ─────────────────────────────────────────

model City {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(100)
  code     String  @unique @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")

  @@schema("references_service")
  @@map("cities")
}

model Rk {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(100)
  code     String  @unique @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  @@schema("references_service")
  @@map("rk")
}

model OrderStatusRef {
  id        Int     @id @default(autoincrement())
  name      String  @unique @db.VarChar(100)
  code      String  @unique @db.VarChar(50)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@schema("references_service")
  @@map("order_statuses")
}

model EquipmentType {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(100)
  code     String  @unique @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  @@schema("references_service")
  @@map("equipment_types")
}

// ─────────────────────────────────────────
// Schema: orders_service (read-only для отчётов)
// ─────────────────────────────────────────

/// Заказы
model Order {
  id              Int       @id @default(autoincrement())
  cityId          Int       @map("city_id")
  rkId            Int       @map("rk_id")
  phone           String    @db.VarChar(20)
  orderTypeId     Int       @map("order_type_id")
  clientName      String    @map("client_name") @db.VarChar(255)
  address         String    @db.Text
  dateMeeting     DateTime  @map("date_meeting")
  equipmentTypeId Int       @map("equipment_type_id")
  problem         String    @db.Text
  statusId        Int       @map("status_id")
  operatorId      Int       @map("operator_id")
  masterId        Int?      @map("master_id")
  result          Decimal?  @db.Decimal(10, 2)
  expenditure     Decimal?  @db.Decimal(10, 2)
  clean           Decimal?  @db.Decimal(10, 2)
  masterChange    Decimal?  @map("master_change") @db.Decimal(10, 2)
  prepayment      Decimal?  @db.Decimal(10, 2)
  callId          String?   @map("call_id") @db.VarChar(100)
  appealId        Int?      @map("appeal_id")
  dateCloseMod    DateTime? @map("date_close_mod")
  closingAt       DateTime? @map("closing_at")
  version         Int       @default(1)
  hasPoverka      Boolean   @default(false) @map("has_poverka")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  cashSubmission CashSubmission?

  @@index([cityId])
  @@index([statusId])
  @@index([masterId])
  @@index([operatorId])
  @@index([createdAt])
  @@index([dateMeeting])
  @@index([closingAt])
  @@index([cityId, statusId])
  @@index([cityId, dateMeeting])
  @@index([masterId, statusId])
  @@index([operatorId, createdAt])
  @@index([cityId, statusId, dateMeeting])
  @@index([statusId, createdAt])
  @@index([cityId, masterId])
  @@index([cityId, operatorId])
  @@schema("orders_service")
  @@map("orders")
}

/// Сдача кассы по заказам
model CashSubmission {
  id          Int       @id @default(autoincrement())
  orderId     Int       @unique @map("order_id")
  status      String    @db.VarChar(50)
  amount      Decimal   @db.Decimal(10, 2)
  receiptDoc  String?   @map("receipt_doc") @db.VarChar(500)
  submittedAt DateTime? @map("submitted_at")
  approvedBy  Int?      @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([submittedAt])
  @@schema("orders_service")
  @@map("cash_submissions")
}

/// Заявки с сайта
model SiteOrder {
  id              Int       @id @default(autoincrement())
  cityId          Int       @map("city_id")
  site            String    @db.VarChar(255)
  clientName      String    @map("client_name") @db.VarChar(255)
  phone           String    @db.VarChar(20)
  status          String?   @db.VarChar(50)
  comment         String?   @db.Text
  commentOperator String?   @map("comment_operator") @db.Text
  orderId         Int?      @map("order_id")
  callbackAt      DateTime? @map("callback_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([cityId])
  @@index([createdAt])
  @@schema("orders_service")
  @@map("site_orders")
}

// ─────────────────────────────────────────
// Schema: auth_service (read-only для отчётов)
// ─────────────────────────────────────────

/// Операторы
model Operator {
  id         Int       @id @default(autoincrement())
  role       String    @db.VarChar(50)
  name       String    @db.VarChar(255)
  login      String    @unique @db.VarChar(255)
  status     String    @db.VarChar(50)
  cityIds    Int[]     @default([]) @map("city_ids")
  sipAddress String?   @map("sip_address") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([status])
  @@schema("auth_service")
  @@map("operators")
}

/// Директора
model Director {
  id        Int       @id @default(autoincrement())
  role      String    @db.VarChar(50)
  name      String    @db.VarChar(255)
  login     String    @unique @db.VarChar(255)
  status    String    @db.VarChar(50)
  cityIds   Int[]     @default([]) @map("city_ids")
  tgId      String?   @map("tg_id") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status])
  @@schema("auth_service")
  @@map("directors")
}

/// Мастера
model Master {
  id        Int       @id @default(autoincrement())
  role      String    @db.VarChar(50)
  name      String    @db.VarChar(255)
  login     String?   @unique @db.VarChar(255)
  status    String    @db.VarChar(50)
  cityIds   Int[]     @default([]) @map("city_ids")
  chatId    String?   @map("chat_id") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status])
  @@index([name])
  @@schema("auth_service")
  @@map("masters")
}

// ─────────────────────────────────────────
// Schema: cash_service (read-only для отчётов)
// ─────────────────────────────────────────

/// Кассовые операции
model Cash {
  id             Int      @id @default(autoincrement())
  cityId         Int      @map("city_id")
  type           String   @db.VarChar(50)
  amount         Decimal  @db.Decimal(10, 2)
  nameCreate     String   @map("name_create") @db.VarChar(255)
  paymentPurpose String?  @unique @map("payment_purpose") @db.VarChar(255)
  note           String?  @db.Text
  receiptDocs    String[] @default([]) @map("receipt_docs")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([cityId])
  @@index([type])
  @@index([createdAt])
  @@schema("cash_service")
  @@map("cash")
}

/// Начисления зарплаты операторам
model OperatorSalary {
  id            Int       @id @default(autoincrement())
  operatorId    Int       @map("operator_id")
  periodStart   DateTime  @map("period_start") @db.Date
  periodEnd     DateTime  @map("period_end") @db.Date
  ordersCount   Int       @default(0) @map("orders_count")
  callsCount    Int       @default(0) @map("calls_count")
  baseAmount    Decimal   @default(0) @map("base_amount") @db.Decimal(10, 2)
  bonusAmount   Decimal   @default(0) @map("bonus_amount") @db.Decimal(10, 2)
  penaltyAmount Decimal   @default(0) @map("penalty_amount") @db.Decimal(10, 2)
  totalAmount   Decimal   @default(0) @map("total_amount") @db.Decimal(10, 2)
  status        String    @default("draft") @db.VarChar(50)
  approvedBy    Int?      @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([operatorId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@schema("cash_service")
  @@map("operator_salary")
}

// ─────────────────────────────────────────
// Schema: calls_service (read-only для отчётов)
// ─────────────────────────────────────────

/// Звонки
model Call {
  id            Int       @id @default(autoincrement())
  cityId        Int       @map("city_id")
  rkId          Int       @map("rk_id")
  callDirection String    @map("call_direction") @db.VarChar(20)
  status        String    @db.VarChar(50)
  phoneClient   String    @map("phone_client") @db.VarChar(20)
  phoneAts      String    @map("phone_ats") @db.VarChar(20)
  duration      Int?
  callId        String?   @unique @map("call_id") @db.VarChar(100)
  operatorId    Int       @map("operator_id")
  masterId      Int?      @map("master_id")
  directorId    Int?      @map("director_id")
  appealId      Int?      @map("appeal_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([cityId])
  @@index([operatorId])
  @@index([createdAt])
  @@index([status])
  @@schema("calls_service")
  @@map("calls")
}
